   "cell_type": "markdown",
   "id": "194c6868",
   "metadata": {},
   "source": [
    "# Sync NAV Data to Database\n",
    "\n",
    "Use the new `/navs/sync/all` endpoint to fetch NAV data for all funds from mftool and push to database.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "f67dec24",
   "metadata": {},
   "outputs": [],
   "source": [
    "import requests\n",
    "import mftool \n",
    "# Option 1: Use the API endpoint to sync all NAV data\n",
    "url = \"http://localhost:8000/navs/sync/all\"\n",
    "\n",
    "# Parameters:\n",
    "# - throttle_sec: Sleep between API calls (default 1.0)\n",
    "# - skip_duplicates: Skip records that exist (default true)\n",
    "\n",
    "response = requests.post(f\"{url}?throttle_sec=1.0&skip_duplicates=true\")\n",
    "\n",
    "print(f\"Status: {response.status_code}\")\n",
    "print(\"Response:\")\n",
    "print(response.json())"
   ]
  },
