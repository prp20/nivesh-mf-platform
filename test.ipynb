    "import requests\n",
    "url = \"http://localhost:8000\"\n",
    "\n",
    "# Step 1: Create the benchmark master first\n",
    "benchmark_code = code.replace(\" \", \"_\").lower()\n",
    "benchmark_payload = {\n",
    "    \"benchmark_code\": benchmark_code,\n",
    "    \"benchmark_name\": code,\n",
    "    \"ticker\": \"^CNXMIDCAP\"  # or your ticker\n",
    "}\n",
    "\n",
    "print(f\"Creating benchmark: {benchmark_code}\")\n",
    "benchmark_res = requests.post(f\"{url}/benchmarks/\", json=benchmark_payload)\n",
    "print(f\"Benchmark creation status: {benchmark_res.status_code}\")\n",
    "if benchmark_res.status_code in [200, 201]:\n",
    "    print(\"Benchmark created/updated successfully\")\n",
    "else:\n",
    "    print(f\"Error: {benchmark_res.text}\")\n",
    "\n",
    "# Step 2: Post NAV data for the benchmark\n",
    "nav_data = {row['date']: float(row['nav']) for _, row in data_1.iterrows()}\n",
    "second_payload = {\n",
    "    \"benchmark_code\": benchmark_code,\n",
    "    \"nav_data\": nav_data\n",
    "}\n",
    "\n",
    "print(f\"\\nUploading NAV data for benchmark: {benchmark_code}\")\n",
    "second_res = requests.post(f\"{url}/benchmark-navs/bulk\", json=second_payload)\n",
    "print(f\"NAV upload status: {second_res.status_code}\")\n",
    "print(f\"Response: {second_res.json()}\")"
   ]
