   "source": [
    "from mftool import Mftool\n",
    "from tqdm import tqdm\n",
    "\n",
    "mf = Mftool()\n",
    "nav_list = []\n",
    "\n",
    "for idx, scheme_code in tqdm(enumerate(scheme_code_data)):\n",
    "    try:\n",
    "        nav_data = mf.get_scheme_historical_nav(str(scheme_code), as_Dataframe=True)\n",
    "        \n",
    "        if nav_data is not None and not nav_data.empty:\n",
    "            # 1. Reset index to move 'date' from index to a column\n",
    "            nav_data.reset_index(inplace=True)\n",
    "            \n",
    "            # 2. Convert to datetime using dayfirst=True to fix the error\n",
    "            nav_data['date'] = pd.to_datetime(nav_data['date'], dayfirst=True)\n",
    "            \n",
    "            # 3. Clean up columns\n",
    "            if 'dayChange' in nav_data.columns:\n",
    "                nav_data.drop(columns=['dayChange'], inplace=True)\n",
    "            nav_data['scheme_code'] = str(scheme_code)\n",
    "            \n",
    "            # 4. Sort Oldest -> Newest\n",
    "            nav_data = nav_data.sort_values(by='date', ascending=True)\n",
    "            \n",
    "            # 5. Format to YYYY-MM-DD\n",
    "            nav_data['date'] = nav_data['date'].dt.strftime('%Y-%m-%d')\n",
    "            \n",
    "            nav_data.reset_index(drop=True, inplace=True)\n",
    "            nav_list.append(nav_data)\n",
    "            \n",
    "    except Exception as e:\n",
    "        print(f\"Error fetching data for {scheme_code}: {e}\")\n",
    "\n",
    "\n"
   ]
  },
